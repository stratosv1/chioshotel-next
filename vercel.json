{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Document-Policy",
          "value": "js-profiling-mode=lazy"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/beds24-refresh-keepalive",
      "schedule": "0 4 * * 1"
    }
  ]
}
