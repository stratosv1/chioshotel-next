{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Document-Policy",
          "value": "js-profiling-mode=lazy"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/beds24-refresh-keepalive/",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/indexnow/",
      "schedule": "17 5 * * 2"
    },
    {
      "path": "/api/cron/availability-watch/",
      "schedule": "17 6 * * *"
    },
    {
      "path": "/api/cron/availability-watch/?run=evening",
      "schedule": "17 18 * * *"
    },
    {
      "path": "/api/booking-core/sync-health/",
      "schedule": "47 4 * * *"
    }
  ]
}
