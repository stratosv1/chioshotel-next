{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/booking-core/sync/",
      "schedule": "*/7 * * * *"
    },
    {
      "path": "/api/booking-core/sync-health/",
      "schedule": "*/7 * * * *"
    },
    {
      "path": "/api/staff/calendar/occupancy-sync/",
      "schedule": "*/7 * * * *"
    },
    {
      "path": "/api/staff/calendar/sync/",
      "schedule": "*/7 * * * *"
    },
    {
      "path": "/api/cron/housekeeping-daily-arrivals-sms/",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/seo/gsc/seasonal-sync/",
      "schedule": "0 5 * * 0"
    },
    {
      "path": "/api/seo/gsc/sync/",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/api/seo/gsc/analyze/",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/seo/health/weekly/",
      "schedule": "30 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\""
        }
      ]
    }
  ]
}
